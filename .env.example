APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ADMIN_EMAILS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_WEBHOOK_URL=
TWILIO_VOICE_WEBHOOK_URL=
VIRTUAL_NUMBER_DEFAULT_CURRENCY=USD
VIRTUAL_NUMBER_DEFAULT_MONTHLY_AMOUNT_MINOR=500
VIRTUAL_NUMBER_USD_TO_NGN_RATE=

WALLET_USD_TO_NGN_RATE=
WALLET_MIN_DEPOSIT_USD=1
WALLET_MAX_DEPOSIT_USD=5000
WALLET_MIN_BALANCE_MINOR=0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spacechip
DB_USERNAME=root
DB_PASSWORD=

CRYPTOMUS_MERCHANT=
CRYPTOMUS_PAYMENT_KEY=

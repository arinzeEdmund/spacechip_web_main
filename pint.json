{
    "preset": "laravel",
    "exclude": ["bootstrap/cache", "storage", "vendor", "node_modules"],
    "rules": {
        "declare_strict_types": false,
        "no_unused_imports": true,
        "ordered_imports": { "sort_algorithm": "alpha" },
        "single_quote": true,
        "no_superfluous_phpdoc_tags": { "allow_mixed": true }
    }
}
